[Unit]
Description=workspace-template
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
User=root
Group=root
RestartSec=5
Restart=on-failure
WorkingDirectory=/opt/workspace-template
ExecStart=/opt/workspace-template/workspace-template.mjs
EnvironmentFile=/opt/workspace-template/.env

[Install]
WantedBy=multi-user.target
